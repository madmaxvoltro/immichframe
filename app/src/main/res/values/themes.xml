<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Immich Frame</string>

    <style name="Frame" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorAccent">#F2B544</item>
        <item name="android:colorPrimary">#0B0B0C</item>
        <item name="android:colorPrimaryDark">#0B0B0C</item>
        <item name="android:textColorPrimary">#F4F1EA</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="Setup" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorAccent">#F2B544</item>
        <item name="android:colorPrimary">#0B0B0C</item>
        <item name="android:colorPrimaryDark">#0B0B0C</item>
        <item name="android:statusBarColor">#0B0B0C</item>
        <item name="android:navigationBarColor">#0B0B0C</item>
    </style>

    <style name="Overlay">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#F4F1EA</item>
        <item name="android:shadowColor">#99000000</item>
        <item name="android:shadowRadius">8</item>
        <item name="android:shadowDy">1</item>
    </style>

    <style name="PillButton" parent="android:Widget.Material.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:background">@drawable/bg_pill_outline</item>
        <item name="android:textColor">#F4F1EA</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:paddingStart">22dp</item>
        <item name="android:paddingEnd">26dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Field">
        <item name="android:layout_height">52dp</item>
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textColor">#F4F1EA</item>
        <item name="android:textColorHint">#77736C</item>
        <item name="android:textSize">17sp</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="Label">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textColor">#CFCAC0</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Toggle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:textColor">#F4F1EA</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="SolidButton" parent="android:Widget.Material.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:textColor">#0B0B0C</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingStart">22dp</item>
        <item name="android:paddingEnd">22dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="GhostButton" parent="SolidButton">
        <item name="android:background">@drawable/bg_button_ghost</item>
        <item name="android:textColor">#F4F1EA</item>
    </style>
</resources>
