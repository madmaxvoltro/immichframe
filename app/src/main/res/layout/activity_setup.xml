<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0B0C"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/columns"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="40dp">

        <LinearLayout
            android:id="@+id/formCol"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Frame setup"
                android:textColor="#F4F1EA"
                android:textSize="32sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Connect this frame to your Immich server."
                android:textColor="#A8A49C"
                android:textSize="16sp" />

            <TextView style="@style/Label" android:text="Immich server URL" />
            <EditText
                android:id="@+id/server"
                style="@style/Field"
                android:layout_width="match_parent"
                android:hint="http://192.168.1.20:2283"
                android:inputType="textUri" />

            <TextView style="@style/Label" android:text="Immich API key" />
            <EditText
                android:id="@+id/apiKey"
                style="@style/Field"
                android:layout_width="match_parent"
                android:hint="Account settings → API keys"
                android:inputType="textPassword" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Needs asset.read, asset.view, album.read, person.read and asset.update (for likes)."
                android:textColor="#A8A49C"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/Label" android:text="Frame name" />
                    <EditText
                        android:id="@+id/name"
                        style="@style/Field"
                        android:layout_width="match_parent"
                        android:inputType="textCapSentences" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/Label" android:text="Seconds per photo" />
                    <EditText
                        android:id="@+id/interval"
                        style="@style/Field"
                        android:layout_width="match_parent"
                        android:inputType="number" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/Label" android:text="Weather latitude" />
                    <EditText
                        android:id="@+id/lat"
                        style="@style/Field"
                        android:layout_width="match_parent"
                        android:hint="52.37"
                        android:inputType="numberDecimal|numberSigned" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/Label" android:text="Weather longitude" />
                    <EditText
                        android:id="@+id/lon"
                        style="@style/Field"
                        android:layout_width="match_parent"
                        android:hint="4.90"
                        android:inputType="numberDecimal|numberSigned" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:background="#222120" />

            <Switch android:id="@+id/smart" style="@style/Toggle" android:text="Smart shuffle (favor liked photos)" />
            <Switch android:id="@+id/pairing" style="@style/Toggle" android:text="Pair two portraits in landscape" />
            <Switch android:id="@+id/ovClock" style="@style/Toggle" android:text="Show clock + date" />
            <Switch android:id="@+id/ovWeather" style="@style/Toggle" android:text="Show weather" />
            <Switch android:id="@+id/ovInfo" style="@style/Toggle" android:text="Show photo info" />
            <Switch android:id="@+id/ovAlbum" style="@style/Toggle" android:text="Show album name" />
            <Switch android:id="@+id/night" style="@style/Toggle" android:text="Screen off at night" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/nightStart"
                    style="@style/Field"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:hint="23:00"
                    android:inputType="time" />

                <EditText
                    android:id="@+id/nightEnd"
                    style="@style/Field"
                    android:layout_width="0dp"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:hint="07:00"
                    android:inputType="time" />
            </LinearLayout>

            <TextView
                android:id="@+id/testResult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:textColor="#A8A49C"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <Button android:id="@+id/btnSave" style="@style/SolidButton" android:text="Save and start" />
                <Button android:id="@+id/btnTest" style="@style/GhostButton" android:layout_marginStart="12dp" android:text="Test connection" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button android:id="@+id/btnWifi" style="@style/GhostButton" android:text="Wi-Fi" />
                <Button android:id="@+id/btnAndroid" style="@style/GhostButton" android:layout_marginStart="12dp" android:text="Android settings" />
                <Button android:id="@+id/btnBack" style="@style/GhostButton" android:layout_marginStart="12dp" android:text="Back to photos" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/remoteCard"
            android:layout_width="360dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="40dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.1"
                android:text="SET UP FROM YOUR PHONE"
                android:textColor="#F2B544"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/qr"
                android:layout_width="280dp"
                android:layout_height="280dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:contentDescription="QR code for the control page" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Scan with your phone camera (same Wi-Fi) and paste your Immich URL + API key there. Or open on any device:"
                android:textColor="#A8A49C"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/apiUrl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="monospace"
                android:textColor="#F4F1EA"
                android:textIsSelectable="true"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/remoteUrl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="#A8A49C"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
